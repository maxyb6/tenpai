# Copy to .env. No secrets in code.
DATABASE_URL=postgresql+psycopg://tenpai:tenpai@localhost:5432/tenpai
TEST_DATABASE_URL=postgresql+psycopg://tenpai:tenpai@localhost:5432/tenpai_test
# Signs per-borrower Mini App links and Telegram start tokens.
LINK_SIGNING_SECRET=change-me
# Set to run a real Telegram bot; leave empty for the in-app simulated chat.
TELEGRAM_BOT_TOKEN=
# Config note only for now: Singapore or in-country, per lender.
DATA_HOSTING_REGION=Singapore (ap-southeast-1)
